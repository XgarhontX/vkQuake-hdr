#ifndef COLOR_CONVERT_INC
#define COLOR_CONVERT_INC

const mat3 BT709_TO_BT2020_MAT = mat3(
    vec3(0.6274039149284363, 0.06909728795289993, 0.0163914393633604),
    vec3(0.3292830288410187, 0.9195404052734375, 0.08801330626010895),
    vec3(0.04331306740641594, 0.01136231515556574, 0.8955952525138855));
const mat3 BT2020_TO_BT709_MAT = mat3(
    vec3(1.6604909896850586, -0.12455047667026520, -0.01815076358616352),
    vec3(-0.5876411199569702, 1.1328998804092407, -0.10057889670133591),
    vec3(-0.07284986227750778, -0.00834942236542702, 1.1187297105789185));
vec3 BT709ToBT2020(vec3 x) { return BT709_TO_BT2020_MAT * x; }
vec3 BT2020ToBT709(vec3 x) { return BT2020_TO_BT709_MAT * x; }
vec3 BT709GammaToBT2020Gamma(vec3 x) { return pow(BT709ToBT2020(pow(x, vec3(2.2))), vec3(1.0 / 2.2)); }
vec3 BT2020GammaToBT709Gamma(vec3 x) { return pow(BT2020ToBT709(pow(x, vec3(2.2))), vec3(1.0 / 2.2)); }
vec4 BT709GammaToBT2020Gamma(vec4 x) { x.rgb = BT709GammaToBT2020Gamma(x.rgb); return x; }
vec4 BT2020GammaToBT709Gamma(vec4 x) { x.rgb = BT2020GammaToBT709Gamma(x.rgb); return x; }

#endif